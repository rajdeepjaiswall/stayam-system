<resources>
    <style name="Theme.SahuSales" parent="android:Theme.Material.Light.NoActionBar"/>
    <!-- windowShowWhenLocked and windowDismissKeyguard are set programmatically
         in AlarmActivity.kt via setShowWhenLocked/setTurnScreenOn (API 27+ path)
